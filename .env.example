# ─── Database ─────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/salestorm
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
